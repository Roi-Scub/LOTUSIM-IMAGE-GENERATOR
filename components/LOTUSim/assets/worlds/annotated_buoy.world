<?xml version="1.0"?>
<sdf version="1.10">
  <world name="annotated_buoy">
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.55 0.68 0.78 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0.4 0.2 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.4 0.2 -1</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
    </light>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <model name="water_surface">
      <static>true</static>
      <link name="surface">
        <visual name="water">
          <pose>0 0 -0.08 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.08 0.24 0.32 1</ambient>
            <diffuse>0.08 0.24 0.32 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://buoy</uri>
      <name>Buoy_001</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="annotation_camera">
      <static>true</static>
      <pose>0 -15 4 0 0.15 1.5707963</pose>
      <link name="camera_link">
        <sensor name="buoy_bbox_camera" type="boundingbox_camera">
          <topic>/dataset/buoy/boxes</topic>
          <camera>
            <box_type>visible_2d</box_type>
            <horizontal_fov>1.2217305</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>80</far></clip>
            <save enabled="true"><path>artifacts/annotated-buoy</path></save>
          </camera>
          <always_on>true</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
