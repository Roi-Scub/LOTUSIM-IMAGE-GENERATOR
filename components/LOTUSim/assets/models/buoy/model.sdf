<?xml version="1.0"?>
<sdf version="1.10">
  <model name="buoy">
    <static>true</static>
    <link name="body">
      <visual name="float">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.38</radius><length>1.1</length></cylinder></geometry>
        <material><ambient>0.95 0.22 0.03 1</ambient><diffuse>0.95 0.22 0.03 1</diffuse></material>
      </visual>
      <visual name="waterline_band">
        <pose>0 0 0.48 0 0 0</pose>
        <geometry><cylinder><radius>0.39</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="beacon_support">
        <pose>0 0 1.22 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.85 0.16 0.02 1</ambient><diffuse>0.85 0.16 0.02 1</diffuse></material>
      </visual>
      <visual name="beacon">
        <pose>0 0 1.42 0 0 0</pose>
