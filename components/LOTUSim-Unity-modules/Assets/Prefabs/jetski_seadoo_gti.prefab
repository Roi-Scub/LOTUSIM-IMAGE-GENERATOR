  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 23a5ddcc3f6654cf0aa3fb13a5f53e50, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  credit:
    model: jetski_seadoo_gti
    title: 2012 Sea-Doo GTI SE 130
    author: BoatUS Foundation
    source: https://sketchfab.com/3d-models/2012-sea-doo-gti-se-130-d7b3e903d7dc43a694720bd347f4fadf
    license: CC-BY-4.0
    licenseUrl: http://creativecommons.org/licenses/by/4.0/
    sha256: c38bb991bcb630ddd4c38f77d9dbd2783845c6f40142ae7e4d9625fb8fad61af
    changes:
    - Mirror GLB conversion retained
    - Baked source node transforms/rest skin pose
    - Simulation scale and artistic waterline; not certified dimensions
    - Unity +X bow +Y up +Z port
    - Grouped meshes by source material; helper line edges omitted, no surface simplification
    - HDRP metallic/roughness/AO/normal map conversion
    - Opaque glass/tints to match existing annotation policy; alpha registration
      decal omitted
    - IOR/specular/transmission extensions approximated, not physically equivalent
    - Existing approximate nine-point wave response added; no propulsion/hydrodynamic
      calibration
