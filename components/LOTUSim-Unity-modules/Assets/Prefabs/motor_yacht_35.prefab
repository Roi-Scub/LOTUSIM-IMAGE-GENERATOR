  m_Name: 
  m_EditorClassIdentifier: 
  credit:
    model: motor_yacht_35
    title: motoryacht 35
    author: angelo raffaele catalano
    source: https://sketchfab.com/3d-models/motoryacht-35-0bdd7a0de7254426890bb5745bb7da6d
    license: CC-BY-4.0
